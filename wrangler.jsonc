{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwv-d1-api",
  "main": "src/index.js",
  "account_id": "7712e75c497be262dad6a07f2378e10d",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "iconv-lite": "./backend/node/iconv-lite-stub.cjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workwithvrajesh-db",
      "database_id": "3d54fc00-0b85-4b29-a63c-a3527785ba92"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA_KV",
      "id": "286d1ef5bdd043fa980cec00537f5a4f"
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "7712e75c497be262dad6a07f2378e10d",
    "CLOUDFLARE_D1_DATABASE_ID": "3d54fc00-0b85-4b29-a63c-a3527785ba92",
    "CLOUDFLARE_D1_DATABASE_NAME": "workwithvrajesh-db",
    "PORT": "8787",
    "UPLOAD_DIR": "./uploads",
    "UPLOAD_URL": "https://wwv-d1-api.workwithvrajesh.workers.dev/uploads",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080,https://workwithvrajesh.com,https://www.workwithvrajesh.com,https://wwv-d1-api.workwithvrajesh.workers.dev"
  }
}
